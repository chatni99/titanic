# Copy this file to .env and set the paths for your machine.
# If you skip it, the notebooks use the defaults shown after each name (relative to where you start Jupyter).

# Folder containing Kaggle's train.csv and test.csv   (default: .)
DATA_DIR=/path/to/titanic

# Where EDA plots are saved   (default: tmp)
PLOTS_DIR=/path/to/titanic/tmp

# Where model pickles are saved   (default: tmp_models)
MODELS_DIR=/path/to/titanic/tmp_models
